<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/about_title">

        <Preference
            android:key="about_version"
            android:title="@string/about_app_header" />

        <Preference
            android:key="about_scope"
            android:title="@string/about_scope_label"
            android:summary="@string/about_scope_value" />

        <Preference
            android:key="about_target_ver"
            android:title="@string/about_target_ver_label"
            android:summary="@string/about_target_ver_value" />

        <Preference
            android:key="about_api"
            android:title="@string/about_api_label"
            android:summary="@string/about_api_value" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about_disclaimer_title">

        <Preference
            android:key="about_disclaimer"
            android:summary="@string/about_disclaimer_content"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about_source_title">

        <Preference
            android:key="about_source"
            android:title="GitHub"
            android:summary="@string/about_source_url" />

    </PreferenceCategory>

</PreferenceScreen>
